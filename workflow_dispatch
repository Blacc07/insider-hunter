name: Solana Momentum Phase 1

on:
  workflow_dispatch: {}          # <-- your external cron-job hits this
  schedule:                      # fallback only (free tier may delay it)
    - cron: "*/5 * * * *"

permissions:
  contents: write

concurrency:
  group: solana-momentum-phase1
  cancel-in-progress: false

jobs:
  phase1:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run Phase 1 discovery
        env:
          SOLANA_RPC_URL: ${{ secrets.SOLANA_RPC_URL }}
        run: python phase1_discovery_filter.py

      - name: Persist state (commit DB back to repo)
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          BRANCH=$(git branch --show-current)
          git add solana_momentum_phase1.db
          git diff --staged --quiet || git commit -m "chore: persist phase1 state [skip ci]"
          git pull --rebase origin "$BRANCH" || true
          git push origin "$BRANCH" || true
